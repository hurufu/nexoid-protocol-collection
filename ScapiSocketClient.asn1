ScapiSocket

DEFINITIONS EXPLICIT TAGS ::=
BEGIN

    IMPORTS
        ScapiRequest,
        ScapiResponse,
        ScapiNotification
    FROM Scapi;

    ScapiSocketRequest ::= SEQUENCE {
        req CHOICE {
            interaction [2] ScapiRequest,
            notification [1] ScapiSocketNotificationRequest,
            registration [0] ScapiSocketRegistrationRequest
        },
        ...
    }

    ScapiSocketResponse ::= SEQUENCE {
        rsp CHOICE {
            interaction [2] ScapiResponse,
            notification [1] ScapiNotification,
            registration [0] ScapiSocketRegistrationAnswer
        },
        ...
    }

    ScapiSocketRegistrationRequest ::= SEQUENCE {
        ...
    }

    ScapiSocketRegistrationAnswer ::= SEQUENCE {
        ...
    }

    ScapiSocketNotificationRequest ::= SEQUENCE {
        ...
    }

END
